+/// 弹层明细的值快照：删除执行后源 Transaction 对象会失效，
+/// 弹层只渲染这里的值，杜绝「已删对象仍在 SwiftUI 渲染」的强桥接崩溃
+struct CategoryDeleteTransactionPreview: Identifiable {
+    let id: NSManagedObjectID
+    let title: String
+    let dateText: String
+    let installmentText: String?
+    /// 带符号金额文案（如 -¥20.00）
+    let amountText: String
+    /// 合计用原始数值
+    let signedAmount: Decimal
+
+    static let dateFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.dateFormat = "yyyy/M/d"
+        return formatter
+    }()
+
+    static func dateText(for date: Date) -> String {
+        dateFormatter.string(from: date)
+    }
+}
+
+/// 删除仍被明细占用的分类时弹出：列出名下明细，由用户决定「转移」还是「一并删除」
+struct CategoryDeleteOptionsSheet: View {
+    @Environment(\.dismiss) private var dismiss
+    private let repository = FinanceRepository.shared
+
+    /// 被删分类的展示快照（源对象删除后仍可安全渲染）
+    let categoryName: String
+    let categoryIcon: String
+    let categoryColor: Color
+    /// 候选目标与被删分类同类型
+    let categoryType: TransactionType
+    /// 已去重、按日期倒序的明细值快照
+    let transactions: [CategoryDeleteTransactionPreview]
+    /// 转移目标候选需排除的 id（被删分类及其子分类）
+    let excludedCategoryIds: Set<UUID>
+    let onConfirm: (CategoryTransactionHandling) -> Void
+
+    private enum HandlingOption { case move, deleteAlong }
+
+    @State private var option: HandlingOption = .move
+    @State private var targetCategory: Category?
+    @State private var candidates: [(category: Category, parentName: String?)] = []
+
+    /// 预览最多展示条数，超出折叠（处理方式对全部明细生效）
+    private static let previewLimit = 100
+
+    private var totalAmountText: String {
+        let total = transactions.reduce(Decimal(0)) { $0 + $1.signedAmount }
+        return NumberFormatter.currency.string(from: NSDecimalNumber(decimal: abs(total))) ?? ""
+    }
+
+    var body: some View {
+        NavigationStack {
+            List {
+                Section {
+                    HStack(spacing: HoloSpacing.md) {
+                        CategoryIconBadge(iconName: categoryIcon, color: categoryColor, diameter: 40)
+                        VStack(alignment: .leading, spacing: 2) {
+                            Text(String(localized: "该分类下还有 \(transactions.count) 笔记账明细"))
+                                .font(.holoBody)
+                            Text(String(localized: "合计金额 \(totalAmountText)，删除前请先选择明细的去向"))
+                                .font(.holoCaption)
+                                .foregroundColor(.holoTextSecondary)
+                        }
+                    }
+                }
+
+                Section(String(localized: "明细处理方式")) {
+                    optionRow(
+                        .move,
+                        title: String(localized: "明细转移到其他分类"),
+                        subtitle: String(localized: "保留记账记录，仅更换归属分类")
+                    )
+                    if option == .move {
+                        NavigationLink {
+                            CategoryTargetPickerView(candidates: candidates, selection: $targetCategory)
+                        } label: {
+                            HStack {
+                                Text(String(localized: "转移到"))
+                                    .foregroundColor(.holoTextPrimary)
+                                Spacer()
+                                Text(targetCategory?.name ?? String(localized: "请选择"))
+                                    .foregroundColor(targetCategory == nil ? .holoTextPlaceholder : .holoTextSecondary)
+                            }
+                        }
+                    }
+                    optionRow(
+                        .deleteAlong,
+                        title: String(localized: "连同明细一起删除"),
+                        subtitle: String(localized: "\(transactions.count) 笔明细将同时删除，无法恢复")
+                    )
+                }
+
+                Section(String(localized: "明细预览（共 \(transactions.count) 笔）")) {
+                    ForEach(transactions.prefix(Self.previewLimit)) { tx in
+                        transactionRow(tx)
+                    }
+                    if transactions.count > Self.previewLimit {
+                        Text(String(localized: "仅显示最近 \(Self.previewLimit) 笔，其余明细按相同方式处理"))
+                            .font(.holoCaption)
+                            .foregroundColor(.holoTextSecondary)
+                    }
+                }
+            }
+            .navigationTitle(String(localized: "删除「\(categoryName)」"))
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
