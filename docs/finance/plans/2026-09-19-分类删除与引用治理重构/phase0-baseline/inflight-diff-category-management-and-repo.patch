+                Spacer()
+                Image(systemName: option == value ? "checkmark.circle.fill" : "circle")
+                    .font(.system(size: 20))
+                    .foregroundColor(option == value ? .holoPrimary : .holoTextPlaceholder)
+            }
+        }
+        .buttonStyle(.plain)
+    }
+
+    private func transactionRow(_ tx: CategoryDeleteTransactionPreview) -> some View {
+        HStack {
+            VStack(alignment: .leading, spacing: 2) {
+                Text(tx.title)
+                    .font(.holoBody)
+                    .foregroundColor(.holoTextPrimary)
+                HStack(spacing: 4) {
+                    Text(tx.dateText)
+                    if let label = tx.installmentText {
+                        Text(label)
+                    }
+                }
+                .font(.holoCaption)
+                .foregroundColor(.holoTextSecondary)
+            }
+            Spacer()
+            Text(tx.amountText)
+                .font(.holoBody)
+                .foregroundColor(.holoTextPrimary)
+        }
+    }
+
+    /// 候选目标：同类型、不在被删家族内的分类；「待分类」置顶并作为默认选中
+    @MainActor
+    private func loadCandidates() async {
+        // 「待分类」是转移的默认去处，尚未被创建过时先补齐（应用内既定不变量）
+        _ = repository.ensurePendingCategory(type: categoryType)
+        guard let all = try? await repository.getAllCategories() else { return }
+        // iCloud 副本天然重复 id，聚合必须 uniquingKeysWith
+        let nameById = Dictionary(all.map { ($0.id, $0.name) }, uniquingKeysWith: { first, _ in first })
+        let sameType = all.filter {
+            $0.transactionType == categoryType
+                && !excludedCategoryIds.contains($0.id)
+                && (!$0.isSystem || $0.name == FinancePendingCategory.currentName)
+        }
+        candidates = sameType
+            .map { cat in (category: cat, parentName: cat.parentId.flatMap { nameById[$0] }) }
+            .sorted { lhs, rhs in
+                let lPending = lhs.category.name == FinancePendingCategory.currentName
+                let rPending = rhs.category.name == FinancePendingCategory.currentName
+                if lPending != rPending { return lPending }
+                let lParent = lhs.parentName ?? ""
+                let rParent = rhs.parentName ?? ""
+                if lParent != rParent { return lParent < rParent }
+                return lhs.category.name < rhs.category.name
+            }
+        if targetCategory == nil {
+            targetCategory = sameType.first { $0.name == FinancePendingCategory.currentName }
+        }
+    }
+}
