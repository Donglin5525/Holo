    "「又一年，幸好还是我们。\n周年快乐！」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Another year, and it's still us. \nHappy Anniversary!”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「又一年，幸好還是我們。\n週年快樂！」"
          }
        }
      }
    },
    "「愿岁岁常欢愉，年年皆胜意。\n生日快乐！」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“May every year bring joy and success. \nHappy Birthday!”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「願歲歲常歡愉，年年皆勝意。\n生日快樂！」"
          }
        }
      }
    },
    "「等了好久的日子，终于到了！」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“The day I've waited for so long has finally arrived!”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「等了好久的日子，終於到了！」"
          }
        }
      }
    },
    "「这一步走了 %lld 天，值得！」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“This step took %lld days, but it was worth it!”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「這一步走了 %lld 天，值得！」"
          }
        }
      }
    },
    "「连续三周晚间支出上扬，与加班周期高度吻合；运动日夜间外卖频次是非运动日的 2.4 倍。」": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「連續三週晚間支出上揚，與加班週期高度吻合；運動日夜間外賣頻次是非運動日的 2.4 倍。」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Evening spending has risen for three consecutive weeks, closely matching overtime cycles; on workout days, late-night takeout frequency is 2.4 times that of non-workout days.”"
          }
        }
      }
    },
    "「餐饮」预算超支了": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「餐飲」預算超支了"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Budget exceeded for “Dining”"
          }
        }
      }
    },
