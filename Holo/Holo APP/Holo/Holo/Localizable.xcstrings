    "将全局重命名「%@」；若与已有标签同名会自动合并": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將全域性重新命名「%@」；若與已有標籤同名會自動合併"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename「%@」globally; if a tag with the same name exists, they will be merged automatically"
          }
