    "\n\n---\n⚠️ AI 响应超时，以上为已接收的部分内容": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n---\n⚠️ AI 響應超時，以上為已接收的部分內容"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "---\n⚠️ AI response timed out. The above is the content received so far."
          }
        }
      }
    },
