          }
        }
      }
    },
    "删除后将无法恢复，30 天后从设备彻底清除。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This cannot be recovered after deletion and will be permanently removed after 30 days."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除後將無法復原，30 天後從裝置徹底清除。"
          }
        }
      }
    },
