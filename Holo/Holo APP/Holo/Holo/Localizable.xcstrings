      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某個預算超支的當天提醒一次，之後不再重複；花銷降回預算以內後，再次超支才會再提醒——不會天天唸叨。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be reminded once on the day a budget is exceeded, and not again afterward. If spending drops back within budget, you'll only be reminded again if it exceeds once more—no daily nagging."
