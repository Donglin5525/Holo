          "stringUnit": {
            "state": "translated",
            "value": "本內容由 AI 基於健康資料分析生成，僅供參考，不構成醫療診斷或專業建議。如有健康問題，請諮詢專業醫生。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This content is AI-generated based on health data analysis and is for reference only. It does not constitute medical diagnosis or professional advice. Consult a doctor for health concerns."
