            "value": "將建立任務「%@」"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task「%@」will be created"
          }
        }
      }
    },
    "将删除所有导入时自动创建的分类（非预设分类），已被交易使用的分类会被保留。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除所有匯入時自動建立的分類（非預設分類），已被交易使用的分類會被保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All categories automatically created during import (non-preset) will be deleted. Categories already used by transactions will be kept."
          }
        }
      }
    },
    "将删除本次导入的 %lld 条交易，以及自动创建且未被引用的分类和账户。导入后被你编辑过的交易不会被删除。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除本次匯入的 %lld 條交易，以及自動建立且未被引用的分類和帳戶。匯入後被你編輯過的交易不會被刪除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will delete %lld transactions from this import, along with automatically created categories and accounts that are not referenced. Transactions you edited after import will not be deleted."
          }
        }
      }
    },
    "将影响 %lld 条想法的标签关联；原文与手动标签不受影响，AI 也不会立即再建回。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將影響 %lld 條想法的標籤關聯；原文與手動標籤不受影響，AI 也不會立即再建回。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will affect tag associations for %lld thoughts. Original text and manual tags will not be affected, and AI will not immediately recreate them."
          }
        }
      }
    },
    "将恢复": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將恢復"
