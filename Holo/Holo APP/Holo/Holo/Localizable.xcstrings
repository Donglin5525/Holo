    "账单日" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billing Date"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳單日"
          }
        }
      }
    },
    "账单日和还款日用于信用卡「本期账单」统计。若还款日早于账单日（如账单日 25 号、还款日 5 号），系统会自动算到次月。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The billing date and due date are used for the credit card's \"current bill\" statistics. If the due date is earlier than the billing date (e.g., billing date on the 25th, due date on the 5th), the system automatically counts it as the next month."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳單日和還款日用於信用卡「本期帳單」統計。若還款日早於帳單日（如帳單日 25 號、還款日 5 號），系統會自動算到次月。"
          }
        }
      }
    },
