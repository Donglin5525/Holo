      }
    },
    "以下数据将全部进入 30 天回收站，到期自动彻底删除。账号、订阅、登录状态与偏好设置不受影响；健康数据不受影响。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以下資料將全部進入 30 天回收站，到期自動徹底刪除。帳號、訂閱、登入狀態與偏好設定不受影響；健康資料不受影響。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The following data will all go to the 30-day Recycle Bin and be permanently deleted automatically upon expiry. Account, subscription, login status, and preferences are unaffected; health data is unaffected."
          }
        }
      }
    },
    "以后不要推荐 #%@": {
