    "高睡眠日，任务完成率更稳定；低睡眠日，咖啡支出和压力记录更值得回看。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On high-sleep days, task completion is more stable; on low-sleep days, coffee spending and stress records are worth reviewing."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高睡眠日，任務完成率更穩定；低睡眠日，咖啡支出和壓力記錄更值得回看。"
          }
        }
      }
    },
