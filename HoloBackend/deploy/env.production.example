PORT=8787
NODE_ENV=production

HOLO_ENFORCE_APP_ATTEST=false
HOLO_APPLE_CLIENT_IDS=com.tangyuxuan.holo-app,com.holo.Holo
HOLO_INTERNAL_DIAGNOSTICS_APPLE_SUBS=
HOLO_SESSION_SECRET=
HOLO_SESSION_TTL_SECONDS=3600

# §model-rename（2026-10-09）：deepseek-v4-flash / v4-flash-vision-exp 已随 V4 系下线、
# 被官方「暂时」路由到 V4.1 Flash——正名 deepseek-flash 直呼其名，防路由停止断线。
# agent_loop 保留 deepseek-v4-pro：该名长期有效（官方将其路由到 V4.1 Flash 按 Flash 价计费，
# V4.1 Pro 上线后自动指向 Pro 系）。
HOLO_CHAT_PROVIDER=deepseek
HOLO_CHAT_MODEL=deepseek-flash
HOLO_CHAT_TEMPERATURE=0.2
HOLO_CHAT_MAX_TOKENS=1024

HOLO_INTENT_PROVIDER=deepseek
HOLO_INTENT_MODEL=deepseek-flash
HOLO_INTENT_TEMPERATURE=0
HOLO_INTENT_MAX_TOKENS=4096

HOLO_INSIGHT_PROVIDER=deepseek
HOLO_INSIGHT_MODEL=deepseek-flash
HOLO_INSIGHT_MAX_TOKENS=4096
HOLO_INSIGHT_TEMPERATURE=0.3

# 识图通道：V4.1 Flash 原生多模态（image_url 格式不变），钥匙独立于主通道。
HOLO_VISION_EXTRACTION_PROVIDER=deepseek-vision
HOLO_VISION_EXTRACTION_MODEL=deepseek-flash

# 想法智能整理默认开启；供应商数据留存、日志及审核边界经产品负责人核实后才开放生产数据通道。
HOLO_THOUGHT_SEMANTIC_ENABLED=true
HOLO_THOUGHT_TOPIC_INSIGHT_ENABLED=true
HOLO_THOUGHT_SEMANTIC_PRIVACY_VERIFIED=false
HOLO_THOUGHT_TOPIC_INSIGHT_PRIVACY_VERIFIED=false
HOLO_THOUGHT_SEMANTIC_MAX_TOKENS=1400
HOLO_THOUGHT_TOPIC_INSIGHT_NAME_MAX_TOKENS=1600

# Long-term memory silent AI tasks: memory_domain_extraction / memory_cross_domain_fusion.
# Without these they silently fall back to HOLO_CHAT_PROVIDER/MODEL.
# reasoning_effort must stay none/low, or the upstream 30s gateway timeout aborts requests
# (production incident 2026-08: 73% of memory extraction calls aborted).
HOLO_MEMORY_DOMAIN_EXTRACTION_PROVIDER=deepseek
HOLO_MEMORY_DOMAIN_EXTRACTION_MODEL=deepseek-flash
HOLO_MEMORY_DOMAIN_EXTRACTION_REASONING_EFFORT=none
HOLO_MEMORY_DOMAIN_EXTRACTION_REQUESTS_PER_MINUTE=6
HOLO_MEMORY_DOMAIN_EXTRACTION_REQUESTS_PER_DAY=60
HOLO_MEMORY_CROSS_DOMAIN_FUSION_PROVIDER=deepseek
HOLO_MEMORY_CROSS_DOMAIN_FUSION_MODEL=deepseek-flash
HOLO_MEMORY_CROSS_DOMAIN_FUSION_REASONING_EFFORT=low
HOLO_MEMORY_CROSS_DOMAIN_FUSION_REQUESTS_PER_MINUTE=2
HOLO_MEMORY_CROSS_DOMAIN_FUSION_REQUESTS_PER_DAY=10

# Agent 深度推理链路走 V4-Pro（默认思考模式，推理更强）。
# 普通记账/对话/意图识别走 deepseek-flash（按用途配档思考），不受影响。
# maxTokens 提到 8192 给 pro 思考过程留空间，否则 JSON 易被截断触发 INVALID_AGENT_JSON。
HOLO_AGENT_LOOP_PROVIDER=deepseek
HOLO_AGENT_LOOP_MODEL=deepseek-v4-pro
HOLO_AGENT_LOOP_MAX_TOKENS=8192

HOLO_CHAT_REQUESTS_PER_MINUTE=20
HOLO_CHAT_REQUESTS_PER_DAY=50

# §reasoning-budget（2026-10-09 全量补档）：所有 LLM purpose 默认显式配档（tests/routes-reasoning-effort.test.js 锁死），
# 漏配=吃模型默认满档思考。A/B 降档两条（核验/回放摘要 low→none，观察一周质量，异常删行即回滚）：
# HOLO_PERSONAL_CONTEXT_VERIFICATION_REASONING_EFFORT=none
# HOLO_REPLAY_DIGEST_REASONING_EFFORT=none
HOLO_ASR_REQUESTS_PER_MINUTE=10
HOLO_ASR_REQUESTS_PER_DAY=20
HOLO_ASR_MAX_BYTES=10485760
HOLO_ASR_PROVIDER=dashscope

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

DASHSCOPE_API_KEY=
DASHSCOPE_ASR_WEBSOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-realtime
DASHSCOPE_ASR_LANGUAGE=zh
DASHSCOPE_ASR_SAMPLE_RATE=16000

# SQLite database (Docker volume mounted at /data)
HOLO_DB_PATH=/data/holo-backend.db
HOLO_LOG_CAPTURE_CONTENT=false
HOLO_LOG_RETENTION_DAYS=30
HOLO_AGENT_LOOP_REQUESTS_PER_MINUTE=60
HOLO_AGENT_LOOP_REQUESTS_PER_DAY=500
# Agent step 短期响应使用 AES-256-GCM 落盘；填入 `openssl rand -base64 32` 的输出。
HOLO_AGENT_STEP_IDEMPOTENCY_ENCRYPTION_KEY=
# 轮换时暂存旧密钥（逗号分隔）；启动重包裹完成并确认旧记录过期后可移除。
HOLO_AGENT_STEP_IDEMPOTENCY_PREVIOUS_ENCRYPTION_KEYS=
HOLO_AGENT_STEP_IDEMPOTENCY_TTL_SECONDS=86400
HOLO_AGENT_STEP_IDEMPOTENCY_CLEANUP_INTERVAL_MS=3600000

# Admin console (leave password/token empty to disable)
HOLO_ADMIN_TOKEN=
HOLO_ADMIN_USERNAME=admin
HOLO_ADMIN_PASSWORD=
HOLO_ADMIN_SESSION_SECRET=
HOLO_ADMIN_LOG_MAX_ENTRIES=200
HOLO_ADMIN_LOG_DETAIL_MAX_CHARS=20000
